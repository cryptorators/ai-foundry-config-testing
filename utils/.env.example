# ============================================================================
# Azure AI Foundry Network-Secured Agent Setup - Environment Configuration
# ============================================================================
# This file contains environment variables needed for the notebook to work.
# 
# SETUP INSTRUCTIONS:
# 1. Copy this file to `.env` in the same directory
# 2. Fill in your actual values (remove <REPLACE ...> placeholders)
# 3. Do NOT commit the `.env` file (it contains sensitive data)
#
# ============================================================================

# ----------------------------------------------------------------------------
# REQUIRED: Azure AI Foundry Project Resource ID
# ----------------------------------------------------------------------------
# Full resource ID of your AI Foundry project
#
# Format: /subscriptions/{subscriptionId}/resourceGroups/{resourceGroup}/providers/Microsoft.CognitiveServices/accounts/{foundryName}/projects/{projectName}
#
# How to find:
#   Azure Portal → Your AI Foundry Project → Properties → Resource ID
#   OR use Azure CLI:
#   az cognitiveservices account show --name {foundryName} --resource-group {resourceGroup}
#
# Example:
# projectResourceId=/subscriptions/12345678-1234-1234-1234-123456789abc/resourceGroups/rg-ai-foundry/providers/Microsoft.CognitiveServices/accounts/my-foundry/projects/my-project
#
projectResourceId=/subscriptions/<REPLACE your-sub-id>/resourceGroups/<REPLACE your-rg>/providers/Microsoft.CognitiveServices/accounts/<REPLACE your-account-name>/projects/<REPLACE your-project-name>

# ----------------------------------------------------------------------------
# OPTIONAL: Subnet Resource ID (Required for VNET injection)
# ----------------------------------------------------------------------------
# Full resource ID of the subnet to use for network-secured agents
#
# Format: /subscriptions/{subscriptionId}/resourceGroups/{resourceGroup}/providers/Microsoft.Network/virtualNetworks/{vnetName}/subnets/{subnetName}
#
# How to find:
#   Azure Portal → Virtual Network → Subnets → Click your subnet → Properties → Resource ID
#   OR use Azure CLI:
#   az network vnet subnet show --vnet-name {vnetName} --name {subnetName} --resource-group {resourceGroup} --query id -o tsv
#
# Requirements:
#   - Must be in the SAME REGION as your AI Foundry account
#   - Requires at least /28 address space (16 addresses)
#   - Should be delegated to Microsoft.CognitiveServices/accounts
#
# Example:
# subnetId=/subscriptions/12345678-1234-1234-1234-123456789abc/resourceGroups/rg-network/providers/Microsoft.Network/virtualNetworks/vnet-ai/subnets/subnet-agents
#
# ONLY needed if you're creating account capability hosts with VNET injection
subnetId=

# ----------------------------------------------------------------------------
# OPTIONAL: Azure AD Tenant ID
# ----------------------------------------------------------------------------
# Your Azure Active Directory tenant ID
#
# How to find:
#   Azure Portal → Azure Active Directory → Properties → Tenant ID
#   OR use Azure CLI:
#   az account show --query tenantId -o tsv
#
# When needed:
#   - Multi-tenant scenarios
#   - When DefaultAzureCredential needs explicit tenant specification
#   - When working across multiple Azure AD tenants
#
# Example:
# tenantId=12345678-1234-1234-1234-123456789abc
#
tenantId=

# ----------------------------------------------------------------------------
# OPTIONAL: Access Token (for .http files only)
# ----------------------------------------------------------------------------
# Personal access token for REST client extensions (NOT used by notebook)
#
# How to get:
#   az account get-access-token --resource=https://management.azure.com/ --query accessToken -o tsv
#
# Note: The Python notebook uses DefaultAzureCredential instead
# This is ONLY needed if you're using the .http files with REST Client extension
#
token=

# ----------------------------------------------------------------------------
# OPTIONAL: Individual Resource Components (for .http files only)
# ----------------------------------------------------------------------------
# These are extracted automatically by the notebook from projectResourceId
# Only fill these in if you're using the .http files directly
#
subscriptionId=
rg=
foundryName=
projectName=
vnetName=
subnetName=